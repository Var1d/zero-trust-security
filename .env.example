# Template konfigurasi untuk Zero Trust Security.
# Salin file ini menjadi .env, lalu ganti semua placeholder dengan nilai rahasia sendiri.

JWT_ACCESS_SECRET=GANTI_DENGAN_SECRET_ACAK_KUAT_UNTUK_ACCESS_TOKEN
JWT_REFRESH_SECRET=GANTI_DENGAN_SECRET_ACAK_KUAT_UNTUK_REFRESH_TOKEN
GATEWAY_SECRET=GANTI_DENGAN_SECRET_ACAK_KUAT_UNTUK_GATEWAY
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=GANTI_DENGAN_SECRET_ACAK_KUAT_UNTUK_SERVICE_NILAI

# Password akun demo harus minimal 12 karakter.
SEED_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_ADMIN
SEED_DOSEN01_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_DOSEN01
SEED_DOSEN02_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_DOSEN02
SEED_MHS01_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_MHS01
SEED_MHS02_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_MHS02
SEED_MHS03_PASSWORD=GANTI_DENGAN_PASSWORD_DEMO_MHS03

# Jam perubahan/finalisasi nilai (format 24 jam)
ACCESS_HOURS_START=07:00
ACCESS_HOURS_END=21:00
ACCESS_TIME_ZONE=Asia/Jakarta
